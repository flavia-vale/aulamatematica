---
import { depoimentos, site } from '../config/site';

interface Props {
  title?: string;
  intro?: string;
}
const {
  title = 'O que as famílias dizem.',
  intro,
} = Astro.props;

// Sem depoimento real, a seção inteira não existe. Nunca renderizar
// placeholder, exemplo ou texto genérico aqui: um depoimento inventado num
// site comercial é publicidade enganosa. Ver o comentário em config/site.ts.
const temDepoimentos = depoimentos.length > 0;

// Link para as avaliações no perfil do Google.
//
// Por que ele existe e por que é só um link: a Fase 3 estabeleceu que volume
// de avaliação é o critério de ranqueamento em todas as listas de "melhores
// professores" das quatro IAs, e que o lugar da nota com estrela é o perfil
// do Google — não o schema deste site. Em 2026-09-17 as cinco famílias que
// autorizaram depoimento avaliaram lá.
//
// NÃO transformar isto em nota, média ou contagem no site. A regra
// `avaliacao-no-schema` do npm run check continua valendo, e o motivo não
// mudou: o Google não exibe estrela para avaliação que o próprio negócio
// coleta e publica, e derivar nota de mensagem de agradecimento é fabricar
// dado de avaliação. Ver docs/leads-organicos/registro-ciclos.md.
const perfilGoogle = site.social.googleBusiness;
---

{temDepoimentos && (
  <section class="border-t border-stone-200 bg-stone-100/50">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold tracking-widest text-emerald-700 uppercase">Depoimentos</p>
      <h2 class="mt-3 max-w-2xl font-serif text-3xl font-medium tracking-tight text-stone-900 sm:text-4xl">
        {title}
      </h2>
      {intro && <p class="mt-4 max-w-2xl leading-relaxed text-stone-600">{intro}</p>}

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {depoimentos.map((d) => (
          <figure class="flex h-full flex-col rounded-xl border border-stone-200 bg-stone-50 p-6">
            {d.nota && (
              <p class="text-sm text-emerald-700" aria-label={`Nota ${d.nota} de 5`}>
                <span aria-hidden="true">{'★'.repeat(d.nota)}</span>
              </p>
            )}
            <blockquote class="mt-3 flex-1 leading-relaxed text-stone-700">
              <p>“{d.texto}”</p>
            </blockquote>
            <figcaption class="mt-5 border-t border-stone-200 pt-4 text-sm">
              <span class="font-semibold text-stone-900">{d.nome}</span>
              <span class="block text-stone-500">{d.papel}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      {perfilGoogle && (
        <p class="mt-8 text-sm text-stone-600">
          As mensagens acima foram enviadas por famílias atendidas e publicadas com autorização, sem nota atribuída.
          {' '}
          <a
            href={perfilGoogle}
            target="_blank"
            rel="noopener"
            class="font-medium text-emerald-700 underline underline-offset-4 hover:text-emerald-900"
          >
            As avaliações com estrela ficam no perfil do Google
          </a>, onde quem avalia é identificado pela própria conta.
        </p>
      )}
    </div>
  </section>
)}
