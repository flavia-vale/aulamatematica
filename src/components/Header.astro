---
import { site, waLinkFor } from '../config/site';

const nav = [
  { href: '/aulas-particulares-matematica-bh', label: 'Aulas em BH' },
  { href: '/aulas-de-matematica-online', label: 'Online' },
  { href: '/reforco-escolar-matematica', label: 'Reforço Escolar' },
  { href: '/enem-matematica', label: 'ENEM' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/blog', label: 'Blog' },
  { href: '/contato', label: 'Contato' },
];

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const atual = (href: string) => path === href;
---

<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-stone-50/85 backdrop-blur supports-[backdrop-filter]:bg-stone-50/70">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 font-serif text-xl tracking-tight text-stone-900">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-stone-900 font-semibold text-stone-50">∑</span>
      <span class="hidden font-semibold sm:inline">{site.brand}</span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 text-sm font-medium text-stone-700 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={atual(item.href) ? 'page' : undefined}
          class="transition hover:text-stone-950 aria-[current=page]:text-stone-950 aria-[current=page]:underline aria-[current=page]:underline-offset-4"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href={waLinkFor(Astro.url.pathname)}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-full bg-stone-900 px-4 py-2 text-sm font-semibold text-stone-50 transition hover:bg-stone-800"
      >
        Aula diagnóstica
        <span aria-hidden="true">→</span>
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu de navegação"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-stone-300 text-stone-800 transition hover:border-stone-900 hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 lg:hidden"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-icone="abrir">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-icone="fechar" hidden>
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    aria-label="Navegação principal (celular)"
    hidden
    class="border-t border-stone-200 bg-stone-50 lg:hidden"
  >
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2 sm:px-6">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={atual(item.href) ? 'page' : undefined}
            class="block border-b border-stone-200/70 py-3 text-base font-medium text-stone-700 transition last:border-b-0 hover:text-stone-950 aria-[current=page]:font-semibold aria-[current=page]:text-stone-950"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Menu de celular. Sem isto, a navegação some abaixo de lg: e as sete
  // páginas ficam inacessíveis no telefone — que é onde a maioria das
  // famílias procura professor.
  const botao = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  if (botao && menu) {
    const abrir = document.querySelector('[data-icone="abrir"]') as HTMLElement | null;
    const fechar = document.querySelector('[data-icone="fechar"]') as HTMLElement | null;

    const alternar = (mostrar: boolean) => {
      menu.hidden = !mostrar;
      botao.setAttribute('aria-expanded', String(mostrar));
      botao.setAttribute('aria-label', mostrar ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
      if (abrir) abrir.hidden = mostrar;
      if (fechar) fechar.hidden = !mostrar;
    };

    botao.addEventListener('click', () => alternar(menu.hidden));

    // Fecha ao navegar e ao apertar Esc.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) alternar(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        alternar(false);
        botao.focus();
      }
    });
  }
</script>
