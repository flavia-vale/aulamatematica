---
/**
 * Páginas das matérias de exatas do ensino superior.
 *
 * Uma rota por matéria, gerada a partir de `materiasSuperior` em
 * `config/site.ts`. O conteúdo que diferencia cada página — onde o aluno
 * trava, a ementa e os pré-requisitos — vive no config, não aqui, para que
 * nenhuma delas seja um molde preenchido: páginas quase idênticas disputando
 * o mesmo termo canibalizam, e este projeto já mediu isso.
 *
 * Nenhuma delas exibe R$ enquanto `precoSuperior.valor` for nulo. O motivo
 * está no comentário do config.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTAButtons from '../components/CTAButtons.astro';
import FAQ from '../components/FAQ.astro';
import Depoimentos from '../components/Depoimentos.astro';
import { site, materiasSuperior, precoSuperior, type MateriaSuperior } from '../config/site';
import { graph, personSchema, localBusinessSchema, serviceSchemaSuperior, faqSchema, breadcrumbSchema } from '../lib/schema';

export function getStaticPaths() {
  return materiasSuperior.map((m) => ({ params: { materia: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: MateriaSuperior };
const path = `/aula-particular-de-${m.slug}`;
const url = `${site.url}${path}`;

const outras = materiasSuperior.filter((o) => o.slug !== m.slug);

const faqsComuns = [
  { q: `A aula de ${m.nome} é online ou presencial?`, a: `As duas. Online ao vivo por videochamada com lousa digital, para alunos de todo o Brasil, ou presencial em Belo Horizonte e num raio de ${site.presencial.raioKm} km do centro, na casa do aluno ou em local público combinado.` },
  { q: 'Quanto custa a aula de ensino superior?', a: `As matérias de ensino superior têm faixa própria, diferente da de fundamental e médio, e o valor é fechado depois da aula diagnóstica gratuita de ${site.preco.diagnosticoMin} minutos — quando já se sabe o tamanho do trabalho e a frequência necessária. Falar comigo não custa nada e não passa por plataforma.` },
  { q: 'Como funciona a primeira conversa?', a: `São ${site.preco.diagnosticoMin} minutos, sem custo. Você manda a ementa, a lista ou a prova que está travando, eu vejo você resolver, e no fim digo o que encontrei e o que faria. Só depois disso você decide.` },
];
const faqs = [...m.faqs, ...faqsComuns];

const schema = graph(
  personSchema,
  localBusinessSchema,
  serviceSchemaSuperior({
    name: `Aula particular de ${m.nome}`,
    description: m.descricao,
    url,
  }),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Início', url: site.url },
    { name: 'Ensino superior', url: `${site.url}/aulas-particulares-ensino-superior` },
    { name: m.nome, url },
  ]),
);
---

<Base title={m.titulo} description={m.descricao} path={path} schema={schema}>
  <PageHero eyebrow={m.eyebrow} title="" description={m.chamada}>
    <Fragment slot="title">
      {m.h1} <em class="italic text-stone-700">{m.h1Enfase}</em>.
    </Fragment>
    <CTAButtons slot="cta" secondaryHref="#ementa" secondaryLabel="Ver a ementa" />
  </PageHero>

  <!-- Onde o aluno trava: é o que diferencia esta página de qualquer outra -->
  <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold tracking-widest text-stone-500 uppercase">Onde costuma travar</p>
    <h2 class="mt-3 font-serif text-3xl font-medium tracking-tight text-stone-900 sm:text-4xl">
      Em {m.nomeCurto}, a dificuldade quase sempre está num destes pontos.
    </h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-stone-600">
      A aula diagnóstica serve para descobrir em qual deles você está, porque cada um pede um trabalho diferente. Estudar mais do mesmo quando o problema é outro é a forma mais comum de gastar tempo sem mudar a nota.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {m.travas.map((t) => (
        <article class="rounded-xl border border-stone-200 bg-white p-6">
          <p class="font-serif text-lg font-medium text-stone-900">{t.t}</p>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">{t.d}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Ementa -->
  <section id="ementa" class="border-y border-stone-200 bg-stone-900 text-stone-100">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="text-sm font-semibold tracking-widest text-stone-400 uppercase">Ementa coberta</p>
          <h2 class="mt-3 font-serif text-3xl font-medium tracking-tight sm:text-4xl">
            O conteúdo de {m.nome}, do começo ao fim.
          </h2>
          <p class="mt-5 leading-relaxed text-stone-300">
            Trabalho com a ementa, as listas e as provas anteriores da sua disciplina. Cada departamento cobra de um jeito, e o formato da prova pesa tanto quanto o conteúdo.
          </p>
          <p class="mt-4 leading-relaxed text-stone-300">
            <span class="font-medium text-stone-100">O que a matéria exige de trás:</span> {m.prerequisitos}
          </p>
        </div>
        <div class="md:col-span-7">
          <ul class="grid gap-2 sm:grid-cols-2">
            {m.ementa.map((e) => (
              <li class="flex items-start gap-3 rounded-lg bg-stone-800/50 px-4 py-3 text-sm text-stone-200">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-stone-500"></span>{e}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Modalidades -->
  <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold tracking-widest text-stone-500 uppercase">Como é a aula</p>
    <h2 class="mt-3 font-serif text-3xl font-medium tracking-tight text-stone-900 sm:text-4xl">
      Online em todo o Brasil, ou presencial em Belo Horizonte.
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-stone-200 bg-white p-7">
        <p class="font-serif text-xs font-semibold tracking-widest text-emerald-700 uppercase">Online · Todo o Brasil</p>
        <h3 class="mt-2 font-serif text-xl font-medium text-stone-900">Videochamada com lousa digital</h3>
        <p class="mt-3 text-sm leading-relaxed text-stone-600">
          A lousa digital não acaba, o que importa numa conta longa de {m.nomeCurto}: dá para rolar para cima e rever a passagem anterior enquanto resolve. Gravação opcional e material enviado depois da aula.
        </p>
      </article>
      <article class="rounded-2xl border border-stone-200 bg-white p-7">
        <p class="font-serif text-xs font-semibold tracking-widest text-emerald-700 uppercase">Presencial · BH e {site.presencial.raioKm} km</p>
        <h3 class="mt-2 font-serif text-xl font-medium text-stone-900">Perto da faculdade ou em casa</h3>
        <p class="mt-3 text-sm leading-relaxed text-stone-600">
          {site.presencial.ondeTexto.charAt(0).toUpperCase() + site.presencial.ondeTexto.slice(1)}. Cobre {site.presencial.cidades.join(', ')}.
        </p>
      </article>
    </div>

    {!precoSuperior.valor && (
      <p class="mt-8 max-w-3xl text-sm leading-relaxed text-stone-600">
        As matérias de ensino superior têm faixa de valor própria, diferente da de fundamental e médio que está publicada no site. O valor é fechado depois da aula diagnóstica gratuita de {site.preco.diagnosticoMin} minutos, quando já se sabe o tamanho do trabalho. <strong class="text-stone-900">Falar comigo não custa nada, é direto por WhatsApp e não passa por plataforma nenhuma.</strong>
      </p>
    )}
  </section>

  <!-- Outras matérias -->
  <section class="mx-auto max-w-5xl border-t border-stone-200 px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold tracking-widest text-emerald-700 uppercase">Outras matérias de exatas</p>
    <h2 class="mt-3 font-serif text-2xl font-medium tracking-tight text-stone-900">
      Atendo o bloco inteiro do ciclo básico.
    </h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {outras.map((o) => (
        <li class="border-t border-stone-200 pt-5">
          <a href={`/aula-particular-de-${o.slug}`} class="font-medium text-emerald-700 underline underline-offset-4 hover:text-emerald-900">
            {o.nome}
          </a>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">{o.chamada}</p>
        </li>
      ))}
      <li class="border-t border-stone-200 pt-5">
        <a href="/aulas-particulares-ensino-superior" class="font-medium text-emerald-700 underline underline-offset-4 hover:text-emerald-900">
          Todas as matérias de faculdade
        </a>
        <p class="mt-2 text-sm leading-relaxed text-stone-600">A página que reúne as seis, com o que cada uma cobra e por onde começar.</p>
      </li>
    </ul>
  </section>

  <Depoimentos title="O que dizem as famílias e os alunos." />

  <FAQ items={faqs} title={`Dúvidas sobre aula particular de ${m.nome}`} />

  <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <div class="rounded-3xl border border-stone-900 bg-stone-50 p-10 text-center md:p-14">
      <h2 class="font-serif text-3xl font-medium tracking-tight text-stone-900 sm:text-4xl">
        Manda a lista que está travando.
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-stone-600">
        {site.preco.diagnosticoMin} minutos de diagnóstico, sem custo e sem compromisso. Você sai sabendo onde está o problema em {m.nomeCurto}, mesmo que decida não continuar comigo.
      </p>
      <CTAButtons />
    </div>
  </section>
</Base>
